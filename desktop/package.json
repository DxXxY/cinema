{
  "name": "together-cinema-desktop",
  "productName": "Together Cinema",
  "version": "1.0.0",
  "description": "Together Cinema для Windows: совместный просмотр, трей, уведомления, мини-плеер и горячие клавиши",
  "author": "DxXxY",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.dxxxy.togethercinema",
    "productName": "Together Cinema",
    "copyright": "DxXxY",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Together-Cinema-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Together Cinema",
      "uninstallDisplayName": "Together Cinema"
    },
    "protocols": [
      {
        "name": "Together Cinema",
        "schemes": ["togethercinema"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DxXxY",
        "repo": "cinema",
        "releaseType": "release"
      }
    ]
  }
}
